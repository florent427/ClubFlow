# Dépendances
node_modules/

# Fichiers locaux / OS
.DS_Store
Thumbs.db

# IDE / outils locaux (Cursor, agents)
.cursor/
.agent/
design stich/

# Env (les secrets restent hors dépôt ; utiliser .env.example)
.env
.env.local
*.log

# Claude Code worktree metadata (contient login JWT, logs, etc.)
.claude/*
# ... mais on versionne les skills custom partagés (équipe + multi-machine)
!.claude/skills/
# ... et les hooks projet partagés (commandes portables, sans chemin absolu)
!.claude/settings.json

# Comptes de test staging (jamais commit)
staging-test-accounts.local.md

# Scripts SQL opérationnels : contiennent des noms réels, des identifiants
# utilisateur et des manipulations de base. Le dépôt est PUBLIC.
bin/*.sql

# Clé de compte de service Google Play (publication mobile).
# JAMAIS dans le dépôt : elle autorise à publier sous l'identité de l'éditeur.
# Référencée par chemin absolu depuis eas.json (serviceAccountKeyPath).
google-play-service-account*.json
**/google-play-service-account*.json
play-store-key*.json

# graphify knowledge graph output (local, regenerable)
graphify-out/

# Python bytecode (bin/graphify-enrich.py)
__pycache__/

# Env : toute variante .env.* reste hors dépôt, à tous les niveaux
.env.*
!.env.example
!.env.*.example
# Exceptions volontaires : URL publiques EXPO_PUBLIC_* seulement (aucun secret),
# embarquées dans le build mobile. Ne JAMAIS y ajouter de secret.
!apps/mobile/.env.production
!apps/mobile/.env.staging

# Clés, certificats, keystores et fichiers d'identifiants
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
google-services.json
GoogleService-Info.plist
credentials*.json

# Sorties de build / cache / couverture
dist/
build/
.next/
.expo/
coverage/
